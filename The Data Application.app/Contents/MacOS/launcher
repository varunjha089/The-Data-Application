#!/bin/bash
# Starts The Data Application as a window, without a Terminal window.
# The .app normally sits in the application folder (next to the_data_app.py). Every start from there writes that folder into the user's settings
# folder (app_folder.txt), so a COPY of the .app placed anywhere else (for example /Applications, for Launchpad) still finds the program.
LOGDIR="${THE_DATA_APP_HOME:-$HOME/Library/Application Support/The Data Application}"
mkdir -p "$LOGDIR"
POINTER="$LOGDIR/app_folder.txt"
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
if [ -f "$APP_DIR/the_data_app.py" ]; then
  printf '%s\n' "$APP_DIR" > "$POINTER"
elif [ -f "$POINTER" ] && [ -f "$(head -n 1 "$POINTER")/the_data_app.py" ]; then
  APP_DIR="$(head -n 1 "$POINTER")"
else
  osascript -e 'display dialog "The Data Application cannot find its program files. This copy of the app is outside the application folder, and the folder has not been opened from here yet (or it was moved).\n\nOpen The Data Application.app once from inside its folder (the one that contains the_data_app.py); after that this copy works too." buttons {"OK"} with icon caution with title "The Data Application"'
  exit 1
fi
cd "$APP_DIR" || exit 1
PY=""
for c in /opt/homebrew/bin/python3 /usr/local/bin/python3 /Library/Frameworks/Python.framework/Versions/*/bin/python3 /usr/bin/python3 python3; do
  if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1; then PY="$c"; break; fi
done
if [ -z "$PY" ]; then
  osascript -e 'display dialog "Python 3.9 or newer was not found. Install it from python.org/downloads and open The Data Application again." buttons {"OK"} with icon caution with title "The Data Application"'
  exit 1
fi
exec "$PY" the_data_app.py gui >> "$LOGDIR/app.log" 2>&1
